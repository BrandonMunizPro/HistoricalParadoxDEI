{
  "name": "historical-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Historical strategy game: authoritative campaign simulation with tactical engines behind an adapter boundary.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "map:dev": "vite --host 127.0.0.1",
    "map:build": "vite build --outDir dist-map",
    "map:preview": "vite preview --outDir dist-map --host 127.0.0.1",
    "map:import": "node scripts/import-central-italy.mjs",
    "map:atlas": "npm run build && node scripts/build-settlement-atlas.mjs",
    "map:verify": "node scripts/verify-map.mjs",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/copy-migrations.mjs && node scripts/build-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "map:terrain": "node scripts/import-italy-terrain.mjs",
    "map:verify:italy": "node scripts/verify-italy-map.mjs",
    "map:validate:geography": "node scripts/validate-italy-geography.mjs",
    "map:audit": "npm run build && node scripts/audit-campaign-geography.mjs",
    "map:world": "node scripts/import-world-geography.mjs",
    "map:verify:world": "node scripts/verify-world-map.mjs",
    "map:validate:world": "node scripts/validate-world-geography.mjs",
    "map:ecology": "node scripts/import-regional-ecology.mjs",
    "map:verify:regional": "node scripts/verify-regional-terrain.mjs",
    "map:validate:ecology": "node scripts/validate-regional-ecology.mjs",
    "map:details": "node scripts/import-regional-details.mjs",
    "map:verify:controls": "node scripts/verify-campaign-controls.mjs",
    "map:verify:detail": "node scripts/verify-campaign-detail.mjs",
    "map:profile:streaming": "node scripts/profile-terrain-streaming.mjs",
    "map:verify:streaming": "node scripts/verify-streaming.mjs",
    "atlas:audit": "npm run build && node scripts/audit-settlement-promotion.mjs",
    "map:verify:vs6": "node scripts/verify-vs6-presentation.mjs",
    "map:research": "npm run build && node scripts/build-research-markers.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "pngjs": "^7.0.0",
    "shapefile": "^0.6.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "three": "^0.186.1"
  }
}
